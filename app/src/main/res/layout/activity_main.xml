<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:filterTouchesWhenObscured="true">

    <!-- Unsichtbarer Anmelde-Browser: liegt unter der Anmeldemaske und wird nur bei
         „Anmeldeseite anzeigen“ sichtbar. Er braucht echte Größe, damit die Seite
         normal aufgebaut wird. -->
    <LinearLayout
        android:id="@+id/loginPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/loginPageBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/login_page_title"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/closeLoginPage"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close"
                android:textColor="@color/accent" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/loginWebHolder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Planer -->
    <FrameLayout
        android:id="@+id/plannerPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/plannerWebHolder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/menuButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp"
            android:background="@drawable/menu_button"
            android:contentDescription="@string/menu"
            android:elevation="6dp"
            android:gravity="center"
            android:text="⋯"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Anmeldemaske (Adresse/E-Mail bzw. Code) -->
    <ScrollView
        android:id="@+id/loginScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/infoButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:background="@drawable/info_button"
                android:contentDescription="@string/info"
                android:gravity="center"
                android:text="i"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/card"
                android:elevation="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp"
                android:id="@+id/card">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/app_icon" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/setup_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <!-- Schritt 1 -->
                <LinearLayout
                    android:id="@+id/setupGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <RadioGroup
                        android:id="@+id/serverMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/modeCloud"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/accent"
                            android:text="@string/mode_cloud"
                            android:textColor="@color/text"
                            android:textSize="17sp" />

                        <RadioButton
                            android:id="@+id/modeOwn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:buttonTint="@color/accent"
                            android:text="@string/mode_own"
                            android:textColor="@color/text"
                            android:textSize="17sp" />
                    </RadioGroup>

                    <LinearLayout
                        android:id="@+id/ownGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginStart="32dp"
                        android:orientation="vertical">

                        <RadioGroup
                            android:id="@+id/ownType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/typeAccess"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginEnd="16dp"
                            android:buttonTint="@color/accent"
                            android:text="@string/type_access"
                            android:textColor="@color/text"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/typeLocal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginEnd="16dp"
                            android:buttonTint="@color/accent"
                            android:text="@string/type_local"
                            android:textColor="@color/text"
                            android:textSize="16sp" />
                        </RadioGroup>

                        <LinearLayout
                            android:id="@+id/accessGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/address"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/accessUrlField"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="6dp"
                            android:autofillHints="url"
                            android:background="@drawable/field"
                            android:hint="@string/address_hint"
                            android:imeOptions="actionNext"
                            android:inputType="textUri"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/email"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/emailField"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="6dp"
                            android:autofillHints="emailAddress"
                            android:background="@drawable/field"
                            android:hint="@string/email_hint"
                            android:imeOptions="actionGo"
                            android:inputType="textEmailAddress"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="17sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/localGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                            <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/server"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                            <EditText
                            android:id="@+id/localUrlField"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="6dp"
                            android:autofillHints="url"
                            android:background="@drawable/field"
                            android:hint="@string/server_hint"
                            android:imeOptions="actionNext"
                            android:inputType="textUri"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="17sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                            <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/port"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                            <EditText
                            android:id="@+id/portField"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="6dp"
                            android:importantForAutofill="no"
                            android:background="@drawable/field"
                            android:hint="@string/port_hint"
                            android:imeOptions="actionGo"
                            android:inputType="number"
                            android:maxLength="5"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="17sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Schritt 2 -->
                <EditText
                    android:id="@+id/codeField"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="20dp"
                    android:autofillHints="smsOTPCode"
                    android:background="@drawable/field"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="@string/code_hint"
                    android:imeOptions="actionGo"
                    android:inputType="number"
                    android:letterSpacing="0.2"
                    android:maxLength="12"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="@color/warning"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/showLoginPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:padding="6dp"
                    android:text="@string/show_login_page"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/primaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/button_primary"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/primaryProgress"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/primaryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/request_code"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/codeLinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/backButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/back"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/newCodeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/new_code"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <!-- Version und Build-Datum unten links auf der Startseite -->
    <TextView
        android:id="@+id/versionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Wartebildschirm -->
    <LinearLayout
        android:id="@+id/checkingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/checking"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
